{
  "name": "dsh-agent-bus",
  "version": "0.1.0",
  "description": "Multi-agent orchestration for DeepSeek Harness: assign work, review results, and run DAG workflows between live sessions — without you as the messenger.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-bus",
    "multi-agent"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "sessions"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/write-build-fingerprint.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-title": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../packages/core/agent",
    "@deepseek-ai/dsh-brand": "link:../packages/util/brand",
    "@deepseek-ai/dsh-client-runtime": "link:../packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-slots": "link:../packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-tool": "link:../packages/client/ui-tool",
    "@deepseek-ai/dsh-home-paths": "link:../packages/util/home-paths",
    "@deepseek-ai/dsh-llm": "link:../packages/llm/llm",
    "@deepseek-ai/dsh-sandbox-policy": "link:../packages/sandbox/sandbox-policy",
    "@deepseek-ai/dsh-session": "link:../packages/core/session",
    "@deepseek-ai/dsh-session-title": "link:../packages/session/session-title",
    "@deepseek-ai/dsh-storage-domain": "link:../packages/storage/storage-domain",
    "@deepseek-ai/dsh-system-prompt": "link:../packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../packages/core/tools",
    "@deepseek-ai/dsh-user-approval": "link:../packages/interaction/user-approval",
    "@deepseek-ai/dsh-workspace": "link:../packages/workspace/workspace",
    "@deepseek-ai/schemastery": "link:../vendor/schemastery",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
